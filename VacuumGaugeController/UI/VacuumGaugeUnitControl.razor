@using VacuumGaugeController.UI
@using Radzen
@using Radzen.Blazor

@inherits ReactiveUI.Blazor.ReactiveComponentBase<VacuumGaugeUnitControlViewModel>

<div class="vacuum-gauge-container m-0 p-2">
    <div class="vacuum-gauge-title">
        @ViewModel!.Device.Name
    </div>

    <div class="vacuum-gauge-state mt-2">
        <div class="field-descriptor">Pressure</div>
        <div class="pressure-value">@ViewModel!.State.Pressure.ToString("E4")</div>
        
        <div class="field-descriptor">Status</div>
        <div>
            <RadzenBadge BadgeStyle="@GetStatusBadgeStyle(ViewModel!.State.Status)" Text="@ViewModel!.State.Status.ToUpper()" />
        </div>

        @if (ViewModel!.State.ErrorStatus != "None" && ViewModel!.State.ErrorStatus != "NoError")
        {
            <div class="field-descriptor">Error</div>
            <div>
                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@ViewModel!.State.ErrorStatus.ToUpper()" />
            </div>
        }
    </div>
</div>

@code {
    private BadgeStyle GetStatusBadgeStyle(string status)
    {
        return status.ToLower() switch
        {
            "okay" => BadgeStyle.Success,
            "underrange" => BadgeStyle.Warning,
            "overrange" => BadgeStyle.Warning,
            _ => BadgeStyle.Secondary
        };
    }
}
