@using Radzen
@using Radzen.Blazor
@inherits ReactiveUI.Blazor.ReactiveComponentBase<Lambda103UnitControlViewModel>

<div class="shutter-container p-2">
    <div class="shutter-header d-flex justify-content-between align-items-center mb-2">
        <span class="fw-bold">@ViewModel!.Device.Name</span>
        <RadzenBadge BadgeStyle="@(ViewModel.State.ShutterOpen ? BadgeStyle.Success : BadgeStyle.Danger)" 
                     Text="@(ViewModel.State.ShutterOpen ? "OPEN" : "CLOSED")" />
    </div>

    <div class="shutter-body">
        <div class="mb-3">
            <RadzenButton Click="@(() => ViewModel.ToggleShutterCommand.Execute().Subscribe())"
                          Text="@(ViewModel.State.ShutterOpen ? "Close Shutter" : "Open Shutter")"
                          ButtonStyle="@(ViewModel.State.ShutterOpen ? ButtonStyle.Danger : ButtonStyle.Success)"
                          class="w-100" />
        </div>

        <div class="wheel-control">
            <div class="text-muted small mb-1">Filter Wheel Position</div>
            <div class="d-flex flex-wrap gap-1">
                @for (int i = 0; i <= 9; i++)
                {
                    int pos = i;
                    <RadzenButton Text="@pos.ToString()"
                                  ButtonStyle="@(ViewModel.State.FilterWheel == pos ? ButtonStyle.Primary : ButtonStyle.Light)"
                                  Size="ButtonSize.Small"
                                  Click="@(() => ViewModel.SetWheelCommand.Execute(pos).Subscribe())"
                                  Style="min-width: 35px;" />
                }
            </div>
        </div>
    </div>
</div>

<style>
    .shutter-container {
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 4px;
        background: rgba(0,0,0,0.2);
    }
</style>
