@using MKS651DRemastered.UI
@using Radzen
@using Radzen.Blazor

@inherits ReactiveUI.Blazor.ReactiveComponentBase<MKS651DControlViewModel>

<div class="mks-container m-0 p-0">
    <div class="mks-header">
        <div class="mks-title">@ViewModel!.Device.Name</div>
        <div class="mks-status">
            @if (ViewModel.DeviceState.ValvePosition > 0.1)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="OPEN" />
            }
            else
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="CLOSED" />
            }
        </div>
    </div>

    @if (ViewModel.HasValidData)
    {
        <div class="mks-grid">
            <div class="field-label">Pressure</div>
            <div class="field-value">@($"{ViewModel.DeviceState.Pressure:F2} Torr")</div>

            <div class="field-label">Valve Position</div>
            <div class="field-value">@($"{ViewModel.DeviceState.ValvePosition:F1} %")</div>

            <div class="field-label">Active Setpoint</div>
            <div class="field-value">@ViewModel.DeviceState.ActiveSetpoint</div>
        </div>

        <div class="mks-actions mt-3">
            <RadzenButton Text="Open Valve" Click="@(() => ViewModel.OpenValveCommand.Execute().Subscribe())" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
            <RadzenButton Text="Close Valve" Click="@(() => ViewModel.CloseValveCommand.Execute().Subscribe())" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" />
        </div>

        <div class="mks-setpoints mt-4">
            <h6>Setpoints</h6>
            <RadzenDataGrid Data="@ViewModel.DeviceState.Setpoints" TItem="MKS651DRemastered.UI.State.SetpointState" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="MKS651DRemastered.UI.State.SetpointState" Property="Index" Title="#" Width="50px" />
                    <RadzenDataGridColumn TItem="MKS651DRemastered.UI.State.SetpointState" Property="Pressure" Title="Torr" />
                    <RadzenDataGridColumn TItem="MKS651DRemastered.UI.State.SetpointState" Property="Gain" Title="Gain %" />
                    <RadzenDataGridColumn TItem="MKS651DRemastered.UI.State.SetpointState" Property="Soft" Title="Soft %" />
                </Columns>
            </RadzenDataGrid>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-2">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
            <span>Loading Pressure Data...</span>
        </div>
    }
</div>
