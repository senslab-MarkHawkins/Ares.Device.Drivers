@using Radzen
@using Radzen.Blazor
@inherits ReactiveUI.Blazor.ReactiveComponentBase<UEyeCameraUnitControlViewModel>

<div class="camera-container p-2">
    <div class="camera-header d-flex justify-content-between align-items-center mb-2">
        <span class="fw-bold">@ViewModel!.Device.Name</span>
        <RadzenBadge BadgeStyle="@(ViewModel.State.IsOpened ? BadgeStyle.Success : BadgeStyle.Danger)" 
                     Text="@(ViewModel.State.IsOpened ? "OPENED" : "CLOSED")" />
    </div>

    <div class="camera-body">
        <div class="stats mb-2 small text-muted">
            <div>FPS: @ViewModel.State.FPS.ToString("F1")</div>
            <div>Total Frames: @ViewModel.State.CaptureStatus</div>
        </div>

        <div class="image-preview mb-2" style="height: 150px; background: #111; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 4px;">
            @if (ViewModel.LatestImageBytes != null)
            {
                <img src="data:image/png;base64,@Convert.ToBase64String(ViewModel.LatestImageBytes)" 
                     style="max-width: 100%; max-height: 100%; object-fit: contain;" />
            }
            else
            {
                <span class="text-muted">No image captured</span>
            }
        </div>

        <RadzenButton Click="@(() => ViewModel.CaptureImageCommand.Execute().Subscribe())"
                      Text="Capture Frame"
                      ButtonStyle="ButtonStyle.Primary"
                      class="w-100" />
    </div>
</div>

<style>
    .camera-container {
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 4px;
        background: rgba(0,0,0,0.2);
    }
</style>
