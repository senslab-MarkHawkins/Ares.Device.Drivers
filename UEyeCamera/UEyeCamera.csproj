<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ares.Toolkit.Device" Version="1.2.0" />
    <PackageReference Include="ReactiveUI.SourceGenerators" Version="2.6.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Drawing.Common" Version="10.0.1" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="uEyeDotNet">
      <HintPath>ThirdParty\uEyeDotNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="ThirdParty\uEyeDotNet.dll">
      <Link>uEyeDotNet.dll</Link>
      <TargetPath>uEyeDotNet.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Simulation\test_baseline.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RemoveStaleThirdPartyOutput" BeforeTargets="Build">
    <RemoveDir Directories="$(TargetDir)ThirdParty" Condition="Exists('$(TargetDir)ThirdParty')" />
  </Target>

  <Target Name="PackageAresDriver" AfterTargets="Build">
    <PropertyGroup>
      <StagingFolder>$(ProjectDir)obj\AresStaging\</StagingFolder>
      <PackageName>$(ProjectDir)..\plugins\$(AssemblyName).ares</PackageName>
    </PropertyGroup>

    <ItemGroup>
      <ScopedCssBundle Include="$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css" Condition="Exists('$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css')" />
    </ItemGroup>

    <Copy SourceFiles="@(ScopedCssBundle)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(ScopedCssBundle)' != ''" />

    <RemoveDir Directories="$(StagingFolder)" />
    <MakeDir Directories="$(StagingFolder)" />
    <MakeDir Directories="$(ProjectDir)..\plugins" />

    <Copy SourceFiles="manifest.yaml" DestinationFolder="$(StagingFolder)" />

    <ItemGroup>
      <AllOutputFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)Ares.Device.dll;$(TargetDir)Ares.Datamodel.dll;$(TargetDir)obj\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(AllOutputFiles)" DestinationFiles="@(AllOutputFiles->'$(StagingFolder)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <ZipDirectory SourceDirectory="$(StagingFolder)" DestinationFile="$(PackageName)" Overwrite="true" />
    <RemoveDir Directories="$(StagingFolder)" />
  </Target>
</Project>
