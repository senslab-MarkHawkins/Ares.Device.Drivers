@inherits ReactiveUI.Blazor.ReactiveComponentBase<LaserChillerUnitControlViewModel>

<div class="border rounded p-3 d-flex flex-column gap-3">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <div class="fw-bold">@ViewModel!.DeviceName</div>
      <div class="text-muted small">Mode: @ViewModel!.Mode</div>
    </div>
    <RadzenButton Text="Refresh"
                  ButtonStyle="ButtonStyle.Light"
                  Size="ButtonSize.Small"
                  Click="@(() => ViewModel.RefreshTemperatureCommand.Execute().Subscribe())" />
  </div>

  @if(ViewModel!.HasValidData)
  {
    <div class="row g-2">
      <div class="col-6">
        <RadzenCard Variant="Variant.Flat">
          <div class="text-muted small">Current Temp</div>
          <div class="fs-4">@($"{ViewModel.CurrentTemperature:F1} C")</div>
        </RadzenCard>
      </div>
      <div class="col-6">
        <RadzenCard Variant="Variant.Flat">
          <div class="text-muted small">Target Temp</div>
          <div class="fs-4">@($"{ViewModel.TargetTemperature:F1} C")</div>
        </RadzenCard>
      </div>
    </div>
  }
  else
  {
    <div class="d-flex align-items-center gap-2">
      <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
      <span>Waiting for device state</span>
    </div>
  }

  <RadzenFormField Text="Set Target Temperature" Variant="Variant.Outlined">
    <RadzenNumeric TValue="double?"
                   @bind-Value="ViewModel.DesiredTemperature"
                   ShowUpDown="false"
                   Step="0.1"
                   Min="-99"
                   Max="999"
                   Style="width: 100%;" />
  </RadzenFormField>

  <div class="d-flex gap-2">
    <RadzenButton Text="Apply"
                  ButtonStyle="ButtonStyle.Secondary"
                  Click="@ViewModel.ApplyTargetTemperature" />
    <RadzenButton Text="Run"
                  ButtonStyle="ButtonStyle.Success"
                  Click="@(() => ViewModel.RunModeCommand.Execute().Subscribe())" />
    <RadzenButton Text="Standby"
                  ButtonStyle="ButtonStyle.Warning"
                  Click="@(() => ViewModel.StandbyModeCommand.Execute().Subscribe())" />
  </div>
</div>
